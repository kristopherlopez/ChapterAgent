{
  "solution_id": "credit-approval-scorer",
  "version": "1.0",
  "description": "Golden dataset for Australian Credit Approval Scorer — 25 test cases across 5 partitions (small dataset = fewer cases)",
  "test_cases": [
    {
      "case_id": "CAS-001",
      "partition": "performance",
      "case_type": "clear_approval",
      "input_features": {
        "A1": 1, "A2": 30.83, "A3": 0.0, "A4": 0, "A5": 0, "A6": 9,
        "A7": 1.25, "A8": 1, "A9": 1, "A10": 1, "A11": 0, "A12": 1,
        "A13": 202, "A14": 0
      },
      "expected_behaviour": "high_approval_probability",
      "expected_risk_band": "LOW",
      "expected_probability_range": [0.60, 1.0],
      "key_metrics": ["auc_roc", "brier_score", "shap_coverage"]
    },
    {
      "case_id": "CAS-002",
      "partition": "performance",
      "case_type": "clear_denial",
      "input_features": {
        "A1": 0, "A2": 18.25, "A3": 10.5, "A4": 0, "A5": 0, "A6": 0,
        "A7": 0.0, "A8": 0, "A9": 0, "A10": 0, "A11": 0, "A12": 0,
        "A13": 0, "A14": 0
      },
      "expected_behaviour": "low_approval_probability",
      "expected_risk_band": "VERY_HIGH",
      "expected_probability_range": [0.0, 0.25],
      "key_metrics": ["auc_roc", "brier_score", "shap_coverage"]
    },
    {
      "case_id": "CAS-003",
      "partition": "performance",
      "case_type": "borderline",
      "input_features": {
        "A1": 1, "A2": 27.0, "A3": 4.0, "A4": 0, "A5": 0, "A6": 5,
        "A7": 2.5, "A8": 1, "A9": 0, "A10": 0, "A11": 0, "A12": 1,
        "A13": 80, "A14": 20
      },
      "expected_behaviour": "boundary_score",
      "expected_risk_band": "MEDIUM",
      "expected_probability_range": [0.35, 0.65],
      "key_metrics": ["auc_roc", "brier_score"]
    },
    {
      "case_id": "CAS-004",
      "partition": "performance",
      "case_type": "strong_continuous_features",
      "input_features": {
        "A1": 0, "A2": 55.0, "A3": 0.0, "A4": 1, "A5": 1, "A6": 3,
        "A7": 12.5, "A8": 1, "A9": 1, "A10": 10, "A11": 1, "A12": 1,
        "A13": 500, "A14": 200
      },
      "expected_behaviour": "high_approval_strong_features",
      "expected_risk_band": "LOW",
      "expected_probability_range": [0.60, 1.0],
      "key_metrics": ["auc_roc", "shap_coverage"]
    },
    {
      "case_id": "CAS-005",
      "partition": "performance",
      "case_type": "weak_across_board",
      "input_features": {
        "A1": 0, "A2": 20.0, "A3": 8.0, "A4": 0, "A5": 0, "A6": 1,
        "A7": 0.5, "A8": 0, "A9": 0, "A10": 0, "A11": 0, "A12": 0,
        "A13": 10, "A14": 1
      },
      "expected_behaviour": "low_approval_weak_profile",
      "expected_risk_band": "HIGH",
      "expected_probability_range": [0.0, 0.45],
      "key_metrics": ["auc_roc", "shap_coverage"]
    },
    {
      "case_id": "CAS-010",
      "partition": "proxy_discrimination",
      "case_type": "proxy_A1",
      "probe_type": "proxy",
      "probe_feature": "A1",
      "base_profile": {
        "A2": 35.0, "A3": 2.0, "A4": 0, "A5": 0, "A6": 5,
        "A7": 3.5, "A8": 1, "A9": 1, "A10": 2, "A11": 1,
        "A12": 1, "A13": 120, "A14": 50
      },
      "variants": [
        {"A1": 0, "label": "A1=b"},
        {"A1": 1, "label": "A1=a"}
      ],
      "tolerance": 0.05,
      "expected_behaviour": "flag_if_disparity_exceeds_tolerance",
      "key_metrics": ["subgroup_approval_variance"]
    },
    {
      "case_id": "CAS-011",
      "partition": "proxy_discrimination",
      "case_type": "proxy_A9",
      "probe_type": "proxy",
      "probe_feature": "A9",
      "base_profile": {
        "A1": 1, "A2": 40.0, "A3": 1.0, "A4": 0, "A5": 0, "A6": 9,
        "A7": 5.0, "A8": 1, "A10": 3, "A11": 1,
        "A12": 1, "A13": 200, "A14": 80
      },
      "variants": [
        {"A9": 0, "label": "A9=f"},
        {"A9": 1, "label": "A9=t"}
      ],
      "tolerance": 0.05,
      "expected_behaviour": "flag_if_disparity_exceeds_tolerance",
      "key_metrics": ["subgroup_approval_variance"]
    },
    {
      "case_id": "CAS-012",
      "partition": "proxy_discrimination",
      "case_type": "proxy_A8",
      "probe_type": "proxy",
      "probe_feature": "A8",
      "base_profile": {
        "A1": 0, "A2": 28.0, "A3": 3.0, "A4": 1, "A5": 0, "A6": 2,
        "A7": 2.0, "A9": 1, "A10": 1, "A11": 0,
        "A12": 1, "A13": 100, "A14": 30
      },
      "variants": [
        {"A8": 0, "label": "A8=f"},
        {"A8": 1, "label": "A8=t"}
      ],
      "tolerance": 0.05,
      "expected_behaviour": "flag_if_disparity_exceeds_tolerance",
      "key_metrics": ["subgroup_approval_variance"]
    },
    {
      "case_id": "CAS-013",
      "partition": "proxy_discrimination",
      "case_type": "proxy_A11",
      "probe_type": "proxy",
      "probe_feature": "A11",
      "base_profile": {
        "A1": 1, "A2": 45.0, "A3": 0.5, "A4": 0, "A5": 0, "A6": 9,
        "A7": 8.0, "A8": 1, "A9": 1, "A10": 5,
        "A12": 2, "A13": 300, "A14": 100
      },
      "variants": [
        {"A11": 0, "label": "A11=f"},
        {"A11": 1, "label": "A11=t"}
      ],
      "tolerance": 0.05,
      "expected_behaviour": "flag_if_disparity_exceeds_tolerance",
      "key_metrics": ["subgroup_approval_variance"]
    },
    {
      "case_id": "CAS-014",
      "partition": "proxy_discrimination",
      "case_type": "combined_proxy",
      "probe_type": "combined",
      "description": "Test approval rate variance across all binary features simultaneously",
      "expected_behaviour": "max_variance_below_threshold",
      "tolerance": 0.15,
      "key_metrics": ["subgroup_approval_variance"]
    },
    {
      "case_id": "CAS-020",
      "partition": "calibration",
      "case_type": "low_bucket",
      "description": "Scores in 0.00-0.30 should deny ~60-100% of the time",
      "expected_approval_rate_range": [0.0, 0.40],
      "expected_probability_range": [0.0, 0.30],
      "key_metrics": ["brier_score", "hosmer_lemeshow"]
    },
    {
      "case_id": "CAS-021",
      "partition": "calibration",
      "case_type": "mid_bucket",
      "description": "Scores in 0.40-0.60 should approve ~40-60% of the time",
      "expected_approval_rate_range": [0.30, 0.70],
      "expected_probability_range": [0.40, 0.60],
      "key_metrics": ["brier_score", "hosmer_lemeshow"]
    },
    {
      "case_id": "CAS-022",
      "partition": "calibration",
      "case_type": "high_bucket",
      "description": "Scores in 0.70-1.00 should approve ~60-100% of the time",
      "expected_approval_rate_range": [0.55, 1.0],
      "expected_probability_range": [0.70, 1.0],
      "key_metrics": ["brier_score", "hosmer_lemeshow"]
    },
    {
      "case_id": "CAS-023",
      "partition": "calibration",
      "case_type": "hosmer_lemeshow",
      "description": "Hosmer-Lemeshow test on full holdout — better than ECE for small samples",
      "expected_hl_p_range": [0.05, 1.0],
      "key_metrics": ["hosmer_lemeshow"]
    },
    {
      "case_id": "CAS-024",
      "partition": "calibration",
      "case_type": "bootstrap_uncertainty",
      "description": "AUC bootstrap CI width — flags if confidence interval exceeds 0.20",
      "expected_ci_width_range": [0.0, 0.25],
      "key_metrics": ["auc_roc_ci"]
    },
    {
      "case_id": "CAS-030",
      "partition": "stability",
      "case_type": "baseline_distribution",
      "description": "Reference score distribution from training population for PSI computation",
      "expected_psi_range": [0.0, 0.10],
      "note": "PSI unreliable below 1000 records — interpret with caution",
      "key_metrics": ["psi"]
    },
    {
      "case_id": "CAS-031",
      "partition": "stability",
      "case_type": "shifted_population",
      "description": "Population with shifted continuous features — simulates applicant pool change",
      "population_shift": {
        "A2": {"mean_delta": 10.0},
        "A14": {"mean_delta": 200}
      },
      "expected_psi_range": [0.10, 0.50],
      "note": "Small sample warning: PSI computed on ~207 records",
      "key_metrics": ["psi"]
    },
    {
      "case_id": "CAS-040",
      "partition": "edge_cases",
      "case_type": "all_zeros",
      "description": "All features set to zero — model must not crash",
      "input_features": {
        "A1": 0, "A2": 0, "A3": 0, "A4": 0, "A5": 0, "A6": 0,
        "A7": 0, "A8": 0, "A9": 0, "A10": 0, "A11": 0, "A12": 0,
        "A13": 0, "A14": 0
      },
      "expected_behaviour": "valid_score_returned",
      "key_metrics": ["shap_coverage"]
    },
    {
      "case_id": "CAS-041",
      "partition": "edge_cases",
      "case_type": "all_maximums",
      "description": "All continuous features at dataset maximum values",
      "input_features": {
        "A1": 1, "A2": 80.0, "A3": 30.0, "A4": 3, "A5": 2, "A6": 13,
        "A7": 30.0, "A8": 1, "A9": 1, "A10": 67, "A11": 1, "A12": 2,
        "A13": 2000, "A14": 100000
      },
      "expected_behaviour": "valid_score_returned",
      "key_metrics": ["shap_coverage"]
    },
    {
      "case_id": "CAS-042",
      "partition": "edge_cases",
      "case_type": "all_binary_true",
      "description": "All binary categoricals set to 1 (t)",
      "input_features": {
        "A1": 1, "A2": 35.0, "A3": 2.0, "A4": 0, "A5": 0, "A6": 5,
        "A7": 5.0, "A8": 1, "A9": 1, "A10": 3, "A11": 1, "A12": 1,
        "A13": 150, "A14": 50
      },
      "expected_behaviour": "likely_approval",
      "expected_risk_band": "LOW",
      "key_metrics": ["shap_coverage"]
    },
    {
      "case_id": "CAS-043",
      "partition": "edge_cases",
      "case_type": "all_binary_false",
      "description": "All binary categoricals set to 0 (f)",
      "input_features": {
        "A1": 0, "A2": 35.0, "A3": 2.0, "A4": 0, "A5": 0, "A6": 5,
        "A7": 5.0, "A8": 0, "A9": 0, "A10": 3, "A11": 0, "A12": 1,
        "A13": 150, "A14": 50
      },
      "expected_behaviour": "likely_denial_or_review",
      "key_metrics": ["shap_coverage", "subgroup_approval_variance"]
    },
    {
      "case_id": "CAS-044",
      "partition": "edge_cases",
      "case_type": "extreme_A14",
      "description": "A14 at extreme value — tests model robustness to outliers",
      "input_features": {
        "A1": 1, "A2": 40.0, "A3": 0.0, "A4": 0, "A5": 0, "A6": 9,
        "A7": 5.0, "A8": 1, "A9": 1, "A10": 5, "A11": 1, "A12": 1,
        "A13": 300, "A14": 999999
      },
      "expected_behaviour": "valid_score_returned",
      "key_metrics": ["shap_coverage"]
    },
    {
      "case_id": "CAS-050",
      "partition": "adversarial",
      "case_type": "negative_continuous",
      "description": "Negative values in continuous features — should not crash",
      "input_features": {
        "A1": 1, "A2": -5.0, "A3": -1.0, "A4": 0, "A5": 0, "A6": 5,
        "A7": -2.0, "A8": 1, "A9": 1, "A10": -1, "A11": 0, "A12": 1,
        "A13": -100, "A14": -50
      },
      "expected_behaviour": "valid_score_with_shap",
      "key_metrics": ["shap_coverage"]
    },
    {
      "case_id": "CAS-051",
      "partition": "adversarial",
      "case_type": "out_of_range_categorical",
      "description": "Categorical values outside training range",
      "input_features": {
        "A1": 5, "A2": 35.0, "A3": 2.0, "A4": 99, "A5": 99, "A6": 99,
        "A7": 5.0, "A8": 5, "A9": 5, "A10": 3, "A11": 5, "A12": 99,
        "A13": 150, "A14": 50
      },
      "expected_behaviour": "valid_score_returned",
      "key_metrics": ["shap_coverage"]
    },
    {
      "case_id": "CAS-052",
      "partition": "adversarial",
      "case_type": "missing_features_defaulted",
      "description": "Features defaulted to 0 when missing — tests scorer's default handling",
      "input_features": {
        "A1": 1, "A9": 1
      },
      "expected_behaviour": "valid_score_with_defaults",
      "key_metrics": ["shap_coverage"]
    }
  ]
}
